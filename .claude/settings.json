{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/issue_tracking_check.sh",
            "timeout": 30,
            "statusMessage": "Checking issue-tracking tickets"
          }
        ]
      }
    ]
  }
}
