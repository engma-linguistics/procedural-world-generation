+# The land ice's whiteness, as a global forcing (the run's global temperature, earth.global_temperature, and
+# the time zoom's, timezoom.forcing; PW-449). A cell of land ice reflects ALBEDO_DROP more of the sunshine it
+# gets than the bare ground under it would, but only while that ground would be bare: in the months the bare
+# ground would lie under snow anyway it is as white (its snow's brightness is the climate's own snow-albedo
+# feedback, inside the sensitivity). So each iced cell counts by the sunshine its latitude gets in the bare
+# ground's snow-free months (snowfree_sun), and the climate's sensitivity (C per W/m2) turns the lost sunshine
+# into a temperature. Ice spreading toward the equator gains per km2 (more sun, longer snow-free summers), and
+# the levelling-off comes from the climate, not the area: the colder the planet, the shorter the bare ground's
+# snow-free season, so a cold era's extra ice whitens less that wasn't white already. (Before PW-449: a tanh in
+# the iced area to 3 C, 1.5 C per 3% of the planet, which spent half its cap on today's ice.)
+ALBEDO_DROP = 0.4  # planetary albedo rise where land ice replaces snow-free ground: the surface's ~0.6 (ice
+# ~0.8, land ~0.2), ~2/3 of it at the top of the atmosphere (Köhler et al. 2010: the LGM's ~25 Mkm2 of extra
+# land ice, -3.2 W/m2, on ~7 W/m2 of snow-free sunshine)
+SNOW_RAMP = 5.0  # C: a month's bare ground goes from snow-covered to bare over this span of its mean air
+# temperature, centred on 0 C
+EARTH_ICE_SUN = 3.6  # W/m2: snow-free sunshine on the bare ground under Earth's land ice today (Antarctica,
+# Greenland, 2.8% of the surface; L6, dT = 0, bare_ground), planet mean; the climate model's dT = 0
+# is Earth's climate with that ice
+_SUN = {}
+
+
+def monthly_sun(lat, tilt: float) -> np.ndarray:
+    """(n, 12) daily-mean sunshine at the top of the atmosphere (W/m2) at each latitude in 12 equal months from
+    the March equinox, for a circular orbit."""
+    lat = np.asarray(lat, float)
+    key = (lat.size, float(tilt), hash(lat.tobytes()))
+    if key not in _SUN:
+        from .orbit import insolation
+        if len(_SUN) > 8:
+            _SUN.clear()
+        _SUN[key] = insolation(float(tilt), 0.0, 0.0, lat)
+    return _SUN[key]
+
+
+def snowfree_sun(lat, tilt: float, t_warm, t_cold) -> np.ndarray:
+    """Per cell, the annual-mean sunshine (W/m2) falling in the months its bare ground would be free of snow:
+    each month's air a sine between the coldest and warmest month's (t_warm, t_cold, C, of the bare ground),
+    warmest in mid-July (north) or January (south), bare in proportion to it over SNOW_RAMP around 0 C."""
+    lat = np.asarray(lat, float)
+    q = monthly_sun(lat, tilt)
+    k = np.arange(12)[None, :] + 0.5
+    peak = np.where(lat >= 0, 3.9, 9.9)[:, None]  # months after the March equinox
+    tw, tc = np.asarray(t_warm, float)[:, None], np.asarray(t_cold, float)[:, None]
+    t = 0.5 * (tw + tc) + 0.5 * (tw - tc) * np.cos(2 * np.pi * (k - peak) / 12)
+    return (q * np.clip(t / SNOW_RAMP + 0.5, 0.0, 1.0)).mean(axis=1)
+
+
+def sun_on_ice(lat, iced, tilt: float, t_warm, t_cold, area=None) -> float:
+    """The snow-free sunshine (snowfree_sun) on the bare ground under the iced cells, W/m2 as a mean over the
+    whole planet. t_warm, t_cold: the bare ground's (at the ice's bed), per cell; area: per cell (None: equal
+    cells)."""
+    on = np.asarray(iced, bool)
+    a = np.ones(on.size) if area is None else np.asarray(area, float)
+    if not on.any():
+        return 0.0
+    s = snowfree_sun(np.asarray(lat)[on], tilt, np.asarray(t_warm)[on], np.asarray(t_cold)[on])
+    return float((s * a[on]).sum() / a.sum())
+
+
+def bare_ground(t_warm, t_cold, air):
+    """The bare ground's warmest and coldest month without the sheets' own cold air (air: air_mass of the ice
+    the climate had; it damps the summer of the air over and beside a sheet by SUMMER_DAMP x it, PW-336), i.e.
+    the ground the ice albedo is counted against: no sheet, no sheet's air. (Undone locally: the summer is
+    t_mean + half, damped by D x half_l, so half_l = (t_warm - t_cold) / (2 - D).)"""
+    d = SUMMER_DAMP * np.asarray(air, float)
+    tw, tc = np.asarray(t_warm, float), np.asarray(t_cold, float)
+    return tw + d * np.maximum(tw - tc, 0.0) / (2.0 - d), tc
+
+
+def albedo_cooling(sensitivity: float, sun: float) -> float:
+    """C of global cooling by land ice over bare ground that would get sun W/m2 of snow-free sunshine
+    (sun_on_ice), at a climate sensitivity of this many C per W/m2."""
+    return sensitivity * ALBEDO_DROP * sun
+
+
 # The ice-age cycle a run's (and a zoom's) ice is the average over: precession at four phases x obliquity
 # at +-OBL_AMP/sqrt(2) (the spread of a sine), eccentricity ECC (the rms of the time zoom's), each month's
 # insolation change against the mean orbit times INSOL_K (C per W/m2; the time zoom's insol_k, less over
