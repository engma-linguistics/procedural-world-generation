+@njit(cache=True)
+def unique_samples(idx, q, centers, nbr_off, nbr_idx):
+    """Make the nearest-cell map idx (world cell -> plate cell; q: the world
+    cells' centres in the plate's frame) one-to-one where it can be: of the
+    world cells that share a plate cell, the nearest keeps it and each other
+    takes the nearest of that plate cell's neighbours no world cell samples
+    (if any). A rotated copy of the grid doesn't line up with the world's,
+    so plain nearest sampling shows ~15% of the plate's cells twice and
+    hides ~7% (PW-359): a change made on the two world cells came back to
+    the plate cell only once (the last write), so a hollow filled with
+    sediment on one of them was still there the next step, and the hidden
+    cells missed the step's physics. In place on idx."""
+    n = idx.shape[0]
+    cnt = np.zeros(n, np.int64)
+    for i in range(n):
+        cnt[idx[i]] += 1
+    best = np.full(n, -1, np.int64)
+    bd = np.full(n, -2.0)
+    for i in range(n):
+        r = idx[i]
+        if cnt[r] > 1:
+            d = q[i, 0] * centers[r, 0] + q[i, 1] * centers[r, 1] + q[i, 2] * centers[r, 2]
+            if d > bd[r]:
+                bd[r] = d
+                best[r] = i
+    for i in range(n):
+        r = idx[i]
+        if cnt[r] <= 1 or best[r] == i:
+            continue
+        u, du = -1, -2.0
+        for e in range(nbr_off[r], nbr_off[r + 1]):
+            j = nbr_idx[e]
+            if cnt[j] == 0:
+                d = q[i, 0] * centers[j, 0] + q[i, 1] * centers[j, 1] + q[i, 2] * centers[j, 2]
+                if d > du:
+                    du, u = d, j
+        if u >= 0:
+            idx[i] = u
+            cnt[u] = 1
+            cnt[r] -= 1
