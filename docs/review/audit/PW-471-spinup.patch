+def spin_up(src: dict, step: float, p: TZParams) -> tuple[dict, dict]:
+    """A run's moment settled into the time zoom's own interglacial: spin_kyr of the zoom at I = 0 and the
+    mean orbit, unrecorded; the zoom then starts from that ice, bed and sea level (the zoom as a window on
+    its own cycle, PW-462: the run's ice rule has no calving or shelves, so its marine ice isn't the zoom's
+    balance, PW-436). Earth's ice is observed and kept by the anchor: no spin-up. Returns the source and
+    {kyr, sea_level_m: the spin-up's sea level change (+: the zoom holds less ice than the run)}."""
+    if p.spin_kyr <= 0 or src["source_run"] == "earth":
+        return src, {"kyr": 0.0, "sea_level_m": 0.0}
+    q = replace(p, index="off", obliquity_amp=0.0, ecc_mean=0.0, ecc_100=0.0, ecc_400=0.0, orbit_ref="mean")
+    s = _Sim(src, p.spin_kyr, step, p.spin_kyr, q)
+    s.run(False, time.time())
+    out = dict(src, elev=s.bed - s.sl, ice=s.H.copy(), sea_level=src["sea_level"] + s.sl)
+    return out, {"kyr": p.spin_kyr, "sea_level_m": round(s.sl, 1)}
+
