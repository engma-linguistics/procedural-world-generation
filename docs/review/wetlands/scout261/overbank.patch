+def _overbank(grid, ground, lk, land, runoff_mm, loss, months, no_lake=None, carved=None):
+    """Water each land cell (no lake) loses off its flooded plain, flow
+    units (PW-831). A river's channel is cut to carry its flood month at
+    bankfull where its bed falls at the slope its section needs (Manning,
+    with the hydraulic geometry's width and depth for that flow: OVERBANK_*);
+    on a lower gradient the same section carries only sqrt(S / S_eq) of it,
+    and the months' flow above that spills onto the plain beside it (the Sudd,
+    the inner Niger delta, the Okavango: the Bahr el Jebel's channel carries
+    far less than its inflow). The spill stands on the cell's flat ground
+    (vegetation.floodplain's flatness) and evaporates as open water
+    (lake_evap - aet) until it is gone or the flat ground is all water; the
+    rest drains back to the river. Taken cell by cell down the rivers, so a
+    flat reach shrinks its river toward what its channel carries. months:
+    climate fields temp, t_warm, t_cold, p_jul, p_jan (seasonal_flow's
+    profile of the year: the flood a river's runoff makes)."""
+    from .ocean import cell_area_km2
+    from .vegetation import relief
+    wet, src = lk["wet"], lk["src"]
+    surf = np.where(wet, lk["level"], lk["bed"]).astype(float)
+    _, down, order, _ = route(grid, ground, lk)
+    shape = _month_shape(grid, down, order, runoff_mm, wet, months)
+    a_m2 = cell_area_km2(getattr(grid, "base", grid)) * 1e6
+    d_m = np.sqrt(a_m2)
+    slope = _reach_slope(down, surf if OVERBANK_SLOPE == "bed" else np.where(wet, surf, carved), FLOOD_EPS) / d_m
+    flat = np.clip(1 - relief(grid, ground) / 400.0, 0, 1)
+    ok = land & ~wet & (down >= 0)
+    if no_lake is not None:
+        ok &= ~no_lake
+    cap = np.where(ok, loss * flat, 0.0)  # flow units: open water over all of the cell's flat ground
+    q_unit = float(discharge(grid, np.ones(1))[0])  # m3/s per flow unit
+    (aw, bw), (ad, bd) = OVERBANK_W, OVERBANK_D
+    # S_eq(Q) = (n v / d^(2/3))^2, v = Q / (w d): a power of Q
+    k_eq = (OVERBANK_N / (aw * ad ** (5 / 3))) ** 2
+    e_eq = 2 * (1 - bw - 5 / 3 * bd)
+    return _overbank_k(down, order, src, wet, ok, shape, slope, cap, q_unit, k_eq, e_eq)
+
+
+@njit(cache=True)
+def _overbank_k(down, order, src, wet, ok, shape, slope, cap, q_unit, k_eq, e_eq):
+    n = src.shape[0]
+    flow = src.copy()
+    out = np.zeros(n)
+    for t in range(order.shape[0] - 1, -1, -1):
+        i = order[t]
+        if not wet[i] and flow[i] < 0:
+            flow[i] = 0.0
+        if ok[i] and flow[i] > 0 and cap[i] > 0:
+            peak = 0.0
+            for m in range(12):
+                peak = max(peak, shape[m, i])
+            qf = flow[i] * peak * q_unit  # the flood month, m3/s
+            s_eq = k_eq * qf ** e_eq
+            c = flow[i] * peak * min(np.sqrt(slope[i] / s_eq), 1.0)
+            spill = 0.0
+            wet_m = 0
+            for m in range(12):
+                x = flow[i] * shape[m, i] - c
+                if x > 0:
+                    spill += x
+                    wet_m += 1
+            spill /= 12.0
+            # the plain is under water (and evaporates as open water) only in the months the river spills
+            lost = min(spill, cap[i] * wet_m / 12.0)
+            flow[i] -= lost
+            out[i] = lost
+        d = down[i]
+        if d >= 0:
+            flow[d] += flow[i]
+    return out
+
+
+@njit(cache=True)
+def _reach_slope(down, surf, eps):
+    """m per cell the river falls from each cell down to the end of the flat
+    it is on: a flat (a filled hollow, a lake's surface, the cells route()'s
+    flood lifted, all eps per cell) falls at the slope of the reach it leads
+    to, not at its eps steps; the first step down more than those (2 eps)
+    ends it."""
+    n = down.shape[0]
+    out = np.zeros(n)
+    for i in range(n):
+        j, k = i, 0
+        while down[j] >= 0 and k < n:
+            d = down[j]
+            k += 1
+            step = surf[j] - surf[d]
+            j = d
+            if step > 2.0 * eps:
+                break
+        if k > 0:
+            out[i] = max(surf[i] - surf[j], 0.0) / k
+    return out
+
+
+def _month_shape(grid, down, order, runoff_mm, wet, months):
+    """seasonal_flow's months: each cell's flow by month over its mean, (12, n)."""
+    q = _month_flow(grid, down, order, runoff_mm, wet, months)[0]
+    mean = q.mean(0)
+    return np.where(mean > 1e-12, q / np.maximum(mean, 1e-12), 1.0)
+
