+def andean_shortening(sim, bd, conv, col, thermostat):
+    """PW-1497 (scout 209 screen): km of crust per cell shortened into the belt behind each ocean-continent trench
+    this step, to be stacked like a collision's (stack_collisions). The slab pins the trench (Schellart 2008: an
+    advancing or stable trench goes with overriding-plate shortening, a retreating one with extension), so a share
+    `andean_shortening` of the overriding plate's own advance toward the trench (cm/yr, at most the convergence) is
+    taken up by shortening its edge (Medvedev et al. 2006: the central Andean foreland moves west ~3 cm/yr and the
+    Andes shorten 1-1.75 cm/yr of it). Each km of shortening stacks a continental_thickness column. 'thermo' mode
+    scales it by the volume thermostat (new volume, like the arcs on continents); 'conserve' takes the same volume
+    from the overriding plate's continental cells in proportion to their crust (the area the plate loses, kept as
+    thickness so the area thermostat isn't touched). 'budget' mode: the volume thermostat's signal without its 0.1 floor
+    and at most 1, so shortening stops while the continents hold more crust than their target. 'edge' mode: the
+    trench-edge cell itself pays (down to 10 km), so the volume is kept and the plate loses area at its leading edge."""
+    p, n = sim.params, sim.grid.n
+    out = np.zeros(n)
+    if p.andean_shortening <= 0 or not (bd.a_down.any() or bd.b_down.any()):
+        return out
+    from .motion import velocity
+    up = bd.overriding
+    toward = np.concatenate([-bd.d[bd.a_down], bd.d[bd.b_down]])  # from the overriding cell toward the trench
+    adv = (velocity(sim)[up] * toward).sum(1) * CMYR
+    rate = p.andean_shortening * np.clip(adv, 0.0, bd.at_trenches(conv)) * col.cont[up]
+    km = sim.edge_len * R_KM
+    gain = 1.0
+    if p.andean_mode == "thermo":
+        gain = thermostat
+    elif p.andean_mode == "budget":  # the volume thermostat's own signal, without its 0.1 floor and capped at 1
+        vol = max(float((sim.w_thick * sim.w_cont).mean()), 1e-3)
+        err = np.log(sim.target_fraction() * p.continental_thickness / vol)
+        gain = float(np.clip(np.exp(4 * (err + sim.thermo[0])), 0.0, 1.0))
+    np.maximum.at(out, up, rate * 10.0 * sim.dt_now * p.continental_thickness / km * gain)
+    if p.andean_mode == "edge" and out.any():
+        # the trench-edge cells pay: their crust is pushed into the belt, and an edge drained below 15 km becomes
+        # ocean in subduction_erosion (the plate loses that area at its leading edge; the area thermostat answers)
+        out = np.minimum(out, np.maximum(col.t - 10.0, 0.0) * col.cont)
+        t0 = col.t
+        col.t = col.t - out
+        sim.book("andean.source", t0, col.t, col.cont)
+    if p.andean_mode == "conserve" and out.any():
+        own = sim.owner
+        give = np.bincount(own, weights=out, minlength=P_MAX)
+        have = np.bincount(own, weights=col.t * col.cont, minlength=P_MAX)
+        f = np.minimum(give / np.maximum(have, 1e-9), 0.02)  # (at most 2% of a plate's continental crust a step)
+        out *= np.where(give > 0, f * have / np.maximum(give, 1e-9), 0.0)[own]
+        t0 = col.t
+        col.t = col.t * (1 - f[own] * col.cont)
+        sim.book("andean.source", t0, col.t, col.cont)
+    return out
+
+
