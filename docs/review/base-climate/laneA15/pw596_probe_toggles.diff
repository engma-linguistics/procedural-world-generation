+def westerly_belt(grid: Grid, t_jul: np.ndarray, t_jan: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    """The westerlies' strength (wind()'s belt) in each half-year, per cell:
+    each hemisphere's own in each season. The surface westerlies are
+    eddy-driven: the storms that grow on the mid-latitudes' poleward
+    temperature contrast carry the westerly momentum down to the ground,
+    and the jet they drive scales with that contrast (the thermal wind).
+    So the belt follows each season's and hemisphere's zonal-mean
+    contrast (storminess, the zonal mean jet_stream's thermal wind is built
+    on) over BELT_LAT, relative to the planet's own mean of the four (both
+    seasons, both hemispheres): a planet with no seasons keeps one belt,
+    and the mean strength stays the one the winds are measured in (U_REF).
+    On Earth a weak northern summer (the continents warm, the contrast
+    halves) and strong westerlies all year round the cold Antarctic.
+    t_jul / t_jan: the half-years' temperatures reduced to sea level, C."""
+    a = np.abs(grid.lat)
+    mid = (a >= BELT_LAT[0]) & (a <= BELT_LAT[1])
+    north = grid.lat >= 0
+    g = {}
+    for k, t in (("jul", t_jul), ("jan", t_jan)):
+        st = storminess(grid, t)
+        g[k] = [float(st[mid & h].mean()) if (mid & h).any() else 0.0 for h in (north, ~north)]
+    ref = np.mean(g["jul"] + g["jan"])
+    if ref <= 1e-9:
+        return np.ones(grid.n), np.ones(grid.n)
+    return tuple(np.where(north, g[k][0], g[k][1]) / ref for k in ("jul", "jan"))
