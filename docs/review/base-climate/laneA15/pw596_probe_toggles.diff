+def low_column(grid: Grid, land: np.ndarray, tune: dict) -> np.ndarray:
+    """How much of the air column over each cell its ground's warmth or cold
+    reaches (0..1), which is what sets the pressure of a thermal low or
+    high (hydrostatic: the column's mean temperature). The boundary layer
+    (sum_h) takes on any land's heat within a day; the air above it, up to
+    the depth a continent's heat low reaches (fetch_h), only as much as the
+    land within the synoptic scale (fetch_km) is land (as _summer_fetch).
+    So a narrow land in the westerlies (Patagonia, Tasmania, New Zealand)
+    makes only a shallow low and a continent's interior a deep one. The
+    sea's own column: 1."""
+    bl = tune["sum_h"] / tune["fetch_h"]
+    cont = np.clip(smooth(grid, land.astype(float), tune["fetch_km"]), 0.0, 1.0)
+    if tune["x_col"] in (2, 4):
+        reach = np.clip(smooth(grid, land.astype(float), U_REF * tune["sum_tau"] / 1000.0), 0.0, 1.0)
+        return np.where(land, bl * reach + (1 - bl) * cont, 1.0)
+    return np.where(land, bl + (1 - bl) * cont, 1.0)
