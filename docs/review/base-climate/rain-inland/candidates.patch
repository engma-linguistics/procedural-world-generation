+def inflow_share(ocean: np.ndarray, north: np.ndarray, tune: dict) -> tuple[np.ndarray, np.ndarray]:
+    """The share of the air column's water vapour that rides the land-sea
+    circulation's cross-isobar inflow (monsoon_wind's), per cell, in each
+    half-year (Apr-Sep, Oct-Mar): PW-1099. The inflow is the friction
+    layer's: above it the wind is about geostrophic and runs along the
+    isobars. The vapour falls off with height as the saturation does along
+    the lapse rate (at a fixed relative humidity, e-folding over
+    1 / (q_k LAPSE), ~2.6 km), so a layer h deep holds 1 - exp(-h q_k LAPSE)
+    of it. h: the marine boundary layer over the sea (sea_bl_m), the
+    summer's convective boundary layer over land (sum_h) and the winter's
+    air mass under its inversion (air_m)."""
+    h_sum = np.where(ocean, tune["sea_bl_m"], tune["sum_h"])
+    h_win = np.where(ocean, tune["sea_bl_m"], tune["air_m"])
+    f = lambda h: 1.0 - np.exp(-h * tune["q_k"] * LAPSE)
+    return np.where(north, f(h_sum), f(h_win)), np.where(north, f(h_win), f(h_sum))
+
+
+def convergence(grid: Grid, v: np.ndarray) -> np.ndarray:
+    """The wind's convergence (1/s, > 0: the air piles in) in each cell, as
+    the rain's transport sees it: minus the outward flow through its faces
+    (each the mean of its two cells' winds across it, face_winds'), per
+    unit of its area. v: tangent vectors, U_REF units."""
+    F = _faces(grid)
+    un = (0.5 * (v[F["ea"]] + v[F["eb"]]) * F["n"]).sum(1) * U_REF
+    cell = np.repeat(np.arange(grid.n), np.diff(F["off"]))
+    return -np.bincount(cell, F["sg"] * un[F["eid"]] * F["L"][F["eid"]], grid.n) / F["A"]
 
 
