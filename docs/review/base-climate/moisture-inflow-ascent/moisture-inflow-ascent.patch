+def test_convergence_closes_and_vanishes_for_rotation():
+    """convergence (PW-1100): over the whole sphere what piles in somewhere leaves somewhere else (the area-weighted
+    sum is 0), and a solid-body rotation about the poles neither converges nor diverges anywhere."""
+    g = build_grid(5)
+    F = climate._faces(g)
+    rng = np.random.default_rng(2)
+    v = rng.normal(0, 1, (g.n, 3))
+    v -= (v * g.centers).sum(1, keepdims=True) * g.centers
+    c = climate.convergence(g, v)
+    assert abs((c * F["A"]).sum()) < 1e-9 * (np.abs(c) * F["A"]).sum()
+    rot = np.cross(np.array([0.0, 0.0, 1.0]), g.centers)
+    assert np.abs(climate.convergence(g, rot)).max() < 1e-3 * np.abs(c).max()
+
+
+def test_inflow_share_is_the_friction_layers_vapour():
+    """inflow_share (PW-1099): the share of an exponential vapour column (e-folding 1 / (q_k LAPSE)) below the
+    friction layer: the shallow marine layer holds less than the summer land's, and both less than half."""
+    t = climate.TUNE
+    ocean = np.array([True, False, False])
+    north = np.array([True, True, False])
+    jul, jan = climate.inflow_share(ocean, north, t)
+    f = lambda h: 1 - np.exp(-h * t["q_k"] * climate.LAPSE)
+    assert np.allclose(jul, [f(t["sea_bl_m"]), f(t["sum_h"]), f(t["air_m"])])
+    assert np.allclose(jan, [f(t["sea_bl_m"]), f(t["air_m"]), f(t["sum_h"])])
+    assert 0 < jul[0] < jul[1] < 0.5
