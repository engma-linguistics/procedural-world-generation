.venv/
__pycache__/
# Generated output: reproducible from seed + params
worlds/
runs/
grids/
zooms/
exports/
# Claude Code: keep worktrees and local settings out, share the hook and its wiring
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
data/
!planet/language/data/
# the server's job state (api.Jobs)
.jobs/
.DS_Store
# small previews for the start screen (planet/thumbs.py)
.thumbs/
# the server's gzipped copies of data files (planet/server.py)
.gzcache/
# tools/ice_diag.py --moments output (tools/tz_mean.py suite), regenerable
ice_v2_moments/
ice_diag_out/
briefs/

# reference papers: PDFs stay local (copyright); the folder README indexes them
docs/references/**/*.pdf

# D&D rulebook text cache (copyrighted; never commit)
docs/references/dnd/.cache/
